
# Application
APP_NAME=Agentic Hotel Management API
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=false
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Database
DATABASE_URL=postgresql://postgres:password@host:5432/postgres
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=5
DATABASE_TIMEOUT_SECONDS=10
DATABASE_SSL_MODE=require
SQL_ECHO=false

# Supabase Auth
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://YOUR_PROJECT_REF.supabase.co/auth/v1
SUPABASE_JWKS_URL=https://YOUR_PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_LEEWAY_SECONDS=30

# LLM 
LLM_API_KEY= 
LLM_BASE_URL= 
LLM_MODEL= 

LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=600
ASSISTANT_MAX_MESSAGE_LENGTH=4000
ASSISTANT_MAX_TOOL_ROUNDS=3
# Embeddings 
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2 
EMBEDDING_DIMENSION=384 
EMBEDDING_BATCH_SIZE=32
# Knowledge ingestion 
KNOWLEDGE_MAX_UPLOAD_MB=10 
KNOWLEDGE_CHUNK_SIZE=500 
KNOWLEDGE_CHUNK_OVERLAP=75 
# Retrieval 
RAG_MATCH_COUNT=6 
RAG_MIN_SIMILARITY=0.45